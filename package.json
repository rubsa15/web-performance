{
  "name": "@rubsa15/wperf",
  "version": "1.0.0",
  "description": "CLI para auditar el rendimiento de una web, priorizar mejoras y comparar auditorías.",
  "type": "module",
  "bin": {
    "wperf": "bin/wperf"
  },
  "files": [
    "bin",
    "dist",
    "!dist/**/*.map",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:slow": "WPERF_SLOW=1 vitest run slow",
    "test:watch": "vitest",
    "demo": "node demo/serve.ts site",
    "demo:fixed": "node demo/serve.ts site-fixed",
    "verify": "npm run typecheck && npm run lint && npm test",
    "prepare": "npm run build",
    "prepublishOnly": "npm run verify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rubsa15/web-performance.git"
  },
  "keywords": [
    "performance",
    "lighthouse",
    "cli",
    "web-vitals",
    "claude-code"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/rubsa15/web-performance/issues"
  },
  "homepage": "https://github.com/rubsa15/web-performance#readme",
  "dependencies": {
    "chrome-launcher": "^1.2.2",
    "commander": "^15.0.0",
    "lighthouse": "13.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "puppeteer-core": "25.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
